  "scripts": {
    "postinstall": "rm -rf node_modules/.cache",
    "start": "webpack serve --config=.config/webpack.config.dev.js",
    "build": "webpack --config=.config/webpack.config.prod.js",
    "lint": "eslint src/",
    "storybook": "storybook dev -p 9009",
    "storybook:build": "storybook build",
    "storybook:deploy": "npm run storybook:build && aws s3 sync ./storybook-static s3://make.hmn.md/h2-storybook --acl public-read",
    "playground": "npx @wp-playground/cli@latest server --blueprint=.playground/blueprint-local.json --mount=.:/wordpress/wp-content/themes/h2",
    "playground:demo": "npx @wp-playground/cli@latest server --blueprint=.playground/blueprint.json",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:destroy": "wp-env destroy",
    "wp-env:logs": "wp-env logs",
    "wp-env:cli": "wp-env run cli wp"
